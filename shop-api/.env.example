# shop-api 的全部环境变量。
#
# 生产上这份内容放在 /etc/teachflow/shop-api.env，chown root:root、chmod 0600，
# 由两个 systemd unit 的 EnvironmentFile= 读入。**不要**把填好值的副本放回仓库。
#
# 缺任何一个必填项，进程会在启动时一次列出全部缺失项然后退出——不会带着半份
# 配置跑起来。校验规则见 src/config.ts。
#
# 值里不要加引号：systemd 的 EnvironmentFile 会把引号当成值的一部分。

# ---- 必填 ----

# Postgres 连接串。库只监听 127.0.0.1（postgresql.conf 的 listen_addresses），
# 所以这里永远是 localhost。
DATABASE_URL=postgres://teachflow:CHANGE_ME@127.0.0.1:5432/teachflow

# 发版接口（POST/GET /api/admin/releases）的 Bearer token。只有你自己用。
# 生成：openssl rand -base64 32
ADMIN_TOKEN=CHANGE_ME

# 下载链接的签名密钥。**至少 32 字节**，否则拒绝启动。
# 换掉它会让所有已发出的下载链接立即失效——买家得重新走「重发链接」。
# 生成：openssl rand -base64 48
DOWNLOAD_TOKEN_SECRET=CHANGE_ME

# Polar 的 webhook 签名密钥。在 Polar 后台建 webhook 时拿到，只显示一次。
POLAR_WEBHOOK_SECRET=CHANGE_ME

# ---- Cloudflare R2。异地归档：机器没了还能把六个包和全部历史版本取回来。----
# Account ID 在 R2 概览页的 endpoint 里（https://<ACCOUNT_ID>.r2.cloudflarestorage.com）。
# 两个 key 在「Manage R2 API Tokens」里建，权限选 Object Read & Write，范围限这一个桶。
R2_ACCOUNT_ID=CHANGE_ME
R2_ACCESS_KEY_ID=CHANGE_ME
R2_SECRET_ACCESS_KEY=CHANGE_ME
R2_BUCKET=teachflow-masters

# ---- Resend。交易邮件与更新通知。----
# API key 在 Resend 后台建，权限选 Sending access。
RESEND_API_KEY=CHANGE_ME
# 发件地址的域名必须是 Resend 里已验证的域名，否则每封信都会被拒。
MAIL_FROM=TeachFlow <noreply@tryteachflow.com>

# 母版 zip 的权威副本目录。下载请求直接读它，走网络太慢也太脆。
# 必须与 deploy/shop-api.service 的 ReadWritePaths= 一致。
MASTER_DIR=/srv/teachflow/masters

# 站点根，不带路径、不带尾斜杠。下载链接按它拼出来，写错了发出去的每一封
# 信里都是一条指向错误主机的链接。
PUBLIC_BASE_URL=https://tryteachflow.com

# ---- 选填，下面写的都是默认值 ----

# 监听端口。只绑 127.0.0.1，公网入口只有 Caddy。改了要同步改 Caddyfile。
PORT=8787

# 结算方。polar 或 paddle。Paddle 适配器是为「以后要换」留的接口，目前走 polar。
MOR_PROVIDER=polar

# 下载链接的有效期，天。过期后买家走「重发链接」拿新的，不需要联系人工。
DOWNLOAD_TOKEN_TTL_DAYS=30

# 每个 UTC 日历日最多发多少封信。Resend 免费额度是每日 100 封的硬上限，
# 这里留 20 封给交易邮件（购买后的首封投递、重发链接），剩下 80 封给更新
# 通知的扇出。扇出打满就顺延到次日 00:05 UTC 继续，不会丢。
# 升级 Resend 套餐后要同步调大，否则通知会一直被自己限住。
DAILY_MAIL_BUDGET=80

# 套装包含哪几个 skill，逗号分隔。顺序无关，但 id 必须与 skill 目录名一致。
# 改这一行之后要重跑 npm run migrate——新 id 需要先登记进 skills 表。
BUNDLE_SKILL_IDS=lesson-workflow,ppt-workflow,audio-workflow,word-workflow,worksheet-workflow,report-workflow
