# TeachFlow-KR —— Hetzner 上的纯静态托管。Caddy v2。
#
# 部署与换域名的完整步骤见 deploy/README.md。这里只放配置本身。
#
# 不得添加 basicauth（或任何形式的访问控制）：Stripe 审核员必须能匿名访问，
# 这是预发布站点最常见的驳回原因（spec §6.1 末行、§9.3 第一条）。公开可访问
# 是硬性要求，不是可选的硬化项。
{$SITE_DOMAIN} {
	root * /srv/teachflow/dist
	encode zstd gzip

	# 根路径进默认语言。302 而非 301——将来若加语言协商，301 会被浏览器长期缓存。
	# 目标**不带**尾斜杠：全站 canonical 是无尾斜杠形态（`${SITE.domain}/en`），
	# 跳到 `/en` 让浏览器第一跳就落在 canonical 上（R-13）。
	redir / /en 302

	# 未知语言前缀回默认语言（spec §8）。下面这份允许清单只用于**排除**真实存在的
	# 顶层路径（语言目录、构建产物目录、静态文件），其余一律回 /en。
	#
	# 为什么不用 brief 的 `not path /en/* /ko/* /fonts/* …`：Caddy 的路径匹配里斜杠
	# 是有意义的，`/en/*` **匹配不到裸 `/en`**。于是 canonical 形态的 `/en` 会落进
	# 未知前缀规则被 302 成 `/en`（自我重定向环）或 `/en/`，正是 R-13 要消除的那一跳。
	# 所以 `/en`、`/ko` 必须各自显式列出。
	#
	# 也不要改成 `path_regexp` 的语言前缀匹配：Go 的 RE2 引擎**不支持负向前瞻
	# `(?!…)`**，而 Caddyfile 又会把正则里的 `{2}` 当占位符解析（需写成 `\{2\}`）。
	# 这两个坑都无法在本地验证（沙箱无 caddy 二进制）。纯 `path` 前缀匹配只用最
	# 基本的 matcher，没有正则引擎、没有转义、没有前瞻。
	#
	# 新增顶层目录（例如将来的 `/blog/`）时，必须在下列清单里补一条，否则该目录
	# 下的一切都会被 302 到 /en。
	@unknown_locale not path / /en /en/* /ko /ko/* /_astro/* /fonts/* /samples/* /favicon.svg /robots.txt /sitemap* /404.html
	redir @unknown_locale /en 302

	@immutable path /_astro/* /fonts/*
	header @immutable Cache-Control "public, max-age=31536000, immutable"

	@html path *.html /
	header @html Cache-Control "public, max-age=0, must-revalidate"

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}

	# 直接命中文件，避免 `file_server` 把目录请求 308/301 到带尾斜杠的形态——
	# 那会让每个无尾斜杠 canonical 都多跳一次。`{path}/index.html` 的改写改变了
	# 路径最后一段（文件名），Caddy 据此不再触发它的规范化重定向，`/en` 本身
	# 直接返回 200（R-13）。上线后请用 `curl -sI` 复核这一点（deploy/README.md §6）。
	try_files {path} {path}/index.html {path}.html

	handle_errors {
		# 各语言的未命中路由进对应的本地化 404，保持语言上下文（spec §8 末行）。
		# 其余（含根级语言中立兜底）走 `/404.html`。三个 `rewrite` 是互斥组：
		# 带 matcher 的排在前面，只有第一个命中的会执行；最后一条无 matcher 用
		# `*` 兜底——**不能**写成 `rewrite /404.html`，那会把 `/404.html` 当成
		# matcher 而漏掉目标参数，Caddy 直接报错。
		@en path /en/*
		rewrite @en /en/404/index.html
		@ko path /ko/*
		rewrite @ko /ko/404/index.html
		rewrite * /404.html

		# `file_server` 在 `handle_errors` 内运行时**保留错误的状态码**（Caddy 官方
		# 文档 handle_errors 一节明载）。因此 `/en/<missing>` 返回真正的 404，而不是
		# 软 200（R-50 后半）。不要再加一层 `respond` 兜底：`/404.html` 恒存在，它
		# 永远不会被执行，只会给后来的人留下“状态码需要手动补”的错误印象。
		file_server
	}

	file_server
}
