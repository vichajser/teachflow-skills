---
import {
  VIEWBOX,
  FLOW_NODES,
  FLOW_EDGES,
  INPUT_NODE,
  edgePath,
  nodeColor,
} from './nodes';
import { useTranslations } from '@/i18n/t';
import type { TranslationKey } from '@/i18n/t';
import type { Locale } from '@/i18n/config';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const label = (id: string) => t(`flow.node.${id}` as TranslationKey);

// 三个阶段的文字版分组。SVG 只画得出"谁连着谁"，读屏器读不出来；
// 这份分组把同一件事说成话，并且用上 flow.stage1/2/3 这三个键。
const STAGES = ([1, 2, 3] as const).map((stage) => ({
  stage,
  title: t(`flow.stage${stage}` as TranslationKey),
  nodes: FLOW_NODES.filter((n) => n.stage === stage),
}));
---

<figure class="my-16" data-flow-diagram>
  <figcaption class="mb-6 text-2xl font-semibold text-text-hi">
    {t('flow.title')}
  </figcaption>

  <!--
    SVG 对读屏器是装饰：<text> 之间的连接关系读不出来，
    role="img" + 单个 aria-label 也只能念出标题。结构由下面那份
    列表承担，它在任何断点都留在无障碍树里。
  -->
  <svg
    viewBox={`0 0 ${VIEWBOX.w} ${VIEWBOX.h}`}
    aria-hidden="true"
    focusable="false"
    class="hidden w-full md:block"
  >
    <g data-flow-edges fill="none" stroke-width="2" stroke-linecap="round">
      {FLOW_EDGES.map((edge) => (
        <path
          d={edgePath(edge)}
          data-edge={`${edge.from}->${edge.to}`}
          stroke={edge.to === 'report-workflow' ? nodeColor(3) : nodeColor(2)}
          opacity="0.55"
        />
      ))}
    </g>

    <g data-flow-input>
      <rect
        x={INPUT_NODE.x}
        y={INPUT_NODE.y}
        width={INPUT_NODE.w}
        height={INPUT_NODE.h}
        rx="10"
        fill="#0E1626"
        stroke="#1F2C4A"
      />
      <text
        x={INPUT_NODE.x + INPUT_NODE.w / 2}
        y={INPUT_NODE.y + INPUT_NODE.h / 2 + 5}
        text-anchor="middle"
        fill="#C3CFE4"
        font-size="14"
      >{t('flow.input')}</text>
    </g>

    {FLOW_NODES.map((node) => (
      <g data-flow-node={node.id} data-stage={node.stage}>
        <rect
          x={node.x}
          y={node.y}
          width={node.w}
          height={node.h}
          rx="12"
          fill="#0E1626"
          stroke={nodeColor(node.stage)}
          stroke-width="1.5"
        />
        <text
          x={node.x + node.w / 2}
          y={node.y + 34}
          text-anchor="middle"
          fill="#F2F6FF"
          font-size="16"
          font-weight="600"
        >{label(node.id)}</text>
        {node.outputs.length > 0 && (
          <text
            x={node.x + node.w / 2}
            y={node.y + 60}
            text-anchor="middle"
            fill="#7C8AA6"
            font-size="12"
            font-family="ui-monospace, monospace"
          >{node.outputs.join('  ')}</text>
        )}
      </g>
    ))}
  </svg>

  <!--
    md 以下这是唯一的呈现（SVG 缩到手机宽度就看不清了）；md 以上它对读屏器
    仍然存在，只是视觉上让位给 SVG —— 用 sr-only 而不是 hidden，因为
    `display:none` 会把它从无障碍树里一并摘掉，读屏用户在桌面端就什么都听不到了。
  -->
  <ol data-flow-list class="mt-6 space-y-6 md:sr-only">
    {STAGES.map(({ stage, title, nodes }) => (
      <li>
        <p class="text-sm font-semibold tracking-wide text-text-mute uppercase">
          {title}
        </p>
        <ul class="mt-2 space-y-2">
          {nodes.map((node) => (
            <li
              class="rounded-lg border-l-2 bg-surface px-4 py-3"
              style={`border-color: ${nodeColor(stage)}`}
            >
              <p class="text-text-hi">{label(node.id)}</p>
              {node.outputs.length > 0 && (
                <p class="font-mono text-xs text-text-mute">
                  {node.outputs.join('  ')}
                </p>
              )}
            </li>
          ))}
        </ul>
      </li>
    ))}
  </ol>

  <p class="mt-6 text-sm text-text-mute">{t('flow.constraint')}</p>
</figure>
