---
import { SITE, SITE_VERIFICATION } from '@/config/site';
import { LOCALES, localizePath, type Locale } from '@/i18n/config';

interface Props {
  lang: Locale;
  title: string;
  description: string;
  /** 去掉语言前缀的路径，如 '/buy'、'/legal/refund'、'/' */
  path: string;
  /**
   * 是否声明语言备选（hreflang）。默认 true；错误页传 false。
   * 404 不是语言的另一种呈现，而是"这个 URL 没有内容"——两语 404 互为
   * 备选会让搜索引擎把 /en/404 与 /ko/404 当成同一个可索引资源的两个版本。
   * canonical 保留（每张 404 仍自指）。
   */
  alternates?: boolean;
}

const { lang, title, description, path, alternates = true } = Astro.props;

// path 已按 BaseLayout 的契约剥掉语言前缀，故这里直接加前缀即可；
// 若照抄 Astro.url.pathname（带前缀）会得到 /ko/en/... —— 语言切换器
// 与前缀重组都靠 `localizePath` 只加不剥这一事实，见其 JSDoc。
const url = (locale: Locale) => `${SITE.domain}${localizePath(path, locale)}`;
---

<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={url(lang)} />
{alternates &&
  LOCALES.map((locale) => (
    <link rel="alternate" hreflang={locale} href={url(locale)} />
  ))}
{alternates && <link rel="alternate" hreflang="x-default" href={url('en')} />}

<meta property="og:type" content="website" />
<meta property="og:site_name" content={SITE.productName} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={url(lang)} />
<meta property="og:locale" content={lang === 'ko' ? 'ko_KR' : 'en_GB'} />
<meta property="og:image" content={`${SITE.domain}/og.png`} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={SITE.productName} />
<meta name="twitter:card" content="summary_large_image" />
{/*
  站长平台验证 meta：只在构建时注入了验证码才渲染（见 SITE_VERIFICATION 的
  注释）。四家平台里 Google 用 DNS / HTML 文件 / meta 三选一，meta 是唯一
  不需要碰 DNS 与 Caddy 路由的方式。
*/}
{SITE_VERIFICATION.google && (
  <meta name="google-site-verification" content={SITE_VERIFICATION.google} />
)}
{SITE_VERIFICATION.bing && <meta name="msvalidate.01" content={SITE_VERIFICATION.bing} />}
{SITE_VERIFICATION.naver && (
  <meta name="naver-site-verification" content={SITE_VERIFICATION.naver} />
)}
