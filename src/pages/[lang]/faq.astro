---
import { getCollection, render } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { SITE } from '@/config/site';
import { useTranslations } from '@/i18n/t';
import type { Locale } from '@/i18n/config';
import { breadcrumbs, faqPage, mdToText } from '@/lib/schema';

export { localeStaticPaths as getStaticPaths } from '@/i18n/paths';

const lang = Astro.params.lang as Locale;
const t = useTranslations(lang);

const entries = await getCollection('faq', (e) => e.data.lang === lang);
const answers = await Promise.all(
  entries
    .sort((a, b) => a.data.order - b.data.order)
    .map(async (entry) => ({ entry, Content: (await render(entry)).Content })),
);

/*
 * FAQPage 的问答与页面渲染同一批条目、同一个顺序（answers 这张表），
 * 答案文本从源 markdown 减去语法噪音——schema 里的是纯文本字段。
 * AI 引擎对 FAQPage 的抽取是结构化的：问题原样、答案可被整句摘录。
 */
const schema = [
  breadcrumbs(lang, '/faq'),
  faqPage(
    answers.map(({ entry }) => ({
      question: entry.data.question,
      answer: mdToText(entry.body ?? ''),
    })),
  ),
];
---

<BaseLayout
  lang={lang}
  title={`${t('faq.title')} — ${SITE.productName}`}
  description={t('faq.lead')}
  path="/faq"
  schema={schema}
>
  <h1 class="pt-16 text-4xl font-semibold text-text-hi">{t('faq.title')}</h1>
  <p class="mt-3 max-w-2xl text-lg text-text-body">{t('faq.lead')}</p>

  <div class="mt-10 max-w-3xl space-y-3 pb-16">
    {answers.map(({ entry, Content }) => (
      <details class="rounded-xl border border-border bg-surface px-5 py-4">
        <summary
          class="cursor-pointer text-lg font-medium text-text-hi marker:text-accent"
        >{entry.data.question}</summary>
        <div class="md-body mt-3 text-text-body"><Content /></div>
      </details>
    ))}
  </div>
</BaseLayout>
