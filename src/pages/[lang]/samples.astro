---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { SITE } from '@/config/site';
import SampleCard from '@/components/SampleCard.astro';
import { SAMPLES } from '@/data/samples';
import { useTranslations } from '@/i18n/t';
import type { Locale } from '@/i18n/config';

export { localeStaticPaths as getStaticPaths } from '@/i18n/paths';

const lang = Astro.params.lang as Locale;
const t = useTranslations(lang);
---

<BaseLayout
  lang={lang}
  title={`${t('samples.title')} — ${SITE.productName}`}
  description={t('samples.lead')}
  path="/samples"
>
  <h1 class="pt-16 text-4xl font-semibold text-text-hi">{t('samples.title')}</h1>
  <p class="mt-3 max-w-2xl text-text-body">{t('samples.lead')}</p>
  {/*
    `samples.note` 如实说明这一页给的是什么：五张卡现在都有**真实渲染的预览图**
    （由 skill 自身从同一个教材单元产出），但只有听力音频以其**标题所写的交付
    格式**（.mp3）真实存在，因而只有它给下载按钮。另外四张标题写的是
    .pptx/.xlsx/.docx/.png，手上只有截图——给下载按钮就是让买家点一个"下载
    .pptx"却拿到 PNG。所以那四张留在 pending 分支，文案也相应从"样例准备中"
    改成"仅预览，文件准备中"：卡片上看得见的东西和文字说的必须是同一件事。
    界线的完整理由写在 `src/data/samples.ts` 的顶部注释里。
  */}
  <p class="mt-3 max-w-2xl text-sm text-text-mute">{t('samples.note')}</p>

  <div class="mt-10 grid gap-4 pb-16 md:grid-cols-2 lg:grid-cols-3">
    {SAMPLES.map((sample) => (
      <SampleCard lang={lang} sample={sample} headingLevel={2} />
    ))}
  </div>
</BaseLayout>
