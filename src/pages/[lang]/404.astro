---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { localizePath, type Locale } from '@/i18n/config';
import { useTranslations } from '@/i18n/t';

export { localeStaticPaths as getStaticPaths } from '@/i18n/paths';

// 无 JS、无重定向，纯静态壳；`localizePath('/', lang)` 让回家链接留在本语言。
//
// Soft 404：`dist/{en,ko}/404/index.html` 是目录索引，主机以 HTTP 200 提供，
// 只有 `dist/404.html` 是错误文档。要让访客真正落到这两页，Task 14 的 Caddy
// 配置必须按语言前缀 `handle_errors` 路由到 `/en/404` 与 `/ko/404`——
// 仓库里没有别处记录这条要求。本页不声明 hreflang：错误页没有语言备选。
const lang = Astro.params.lang as Locale;
const t = useTranslations(lang);
---

<BaseLayout
  lang={lang}
  title={`${t('notFound.title')} — TeachFlow-KR`}
  description={t('notFound.body')}
  path="/404"
  alternates={false}
>
  <section class="py-32">
    <h1 class="text-4xl font-semibold text-text-hi">{t('notFound.title')}</h1>
    <p class="mt-3 text-text-body">{t('notFound.body')}</p>
    <a
      href={localizePath('/', lang)}
      class="mt-6 inline-block rounded-lg bg-accent px-5 py-3 font-medium text-white"
    >{t('notFound.home')}</a>
  </section>
</BaseLayout>
