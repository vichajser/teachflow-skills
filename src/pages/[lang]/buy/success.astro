---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { SITE } from '@/config/site';
import { localizePath, type Locale } from '@/i18n/config';
import { useTranslations } from '@/i18n/t';

export { localeStaticPaths as getStaticPaths } from '@/i18n/paths';

const lang = Astro.params.lang as Locale;
const t = useTranslations(lang);

/*
 * Polar 结账成功后的回跳落地页。checkout_id 在 query 里，但这是一张纯静态
 * 兜底页：它不按订单渲染任何东西，只做三件事——确认付款已成功、告诉买家
 * 下载链接正发往他的邮箱、邮件不到时给出重发路径。真正的交付物永远走
 * 邮件里的签名链接，不经这一页。
 */
---

<BaseLayout
  lang={lang}
  title={`${t('buySuccess.title')} — ${SITE.productName}`}
  description={t('buySuccess.metaDescription')}
  path="/buy/success"
>
  <section class="max-w-2xl pb-16 pt-16">
    <h1 class="text-4xl font-semibold text-text-hi">{t('buySuccess.title')}</h1>
    <p class="mt-3 text-lg text-text-body">{t('buySuccess.lead')}</p>

    <div class="mt-8 rounded-xl border border-accent-glow bg-surface p-5">
      <p class="text-text-body">{t('buySuccess.body')}</p>
    </div>

    <p class="mt-6 text-sm text-text-body">
      {t('buySuccess.noMail')}
      {' '}<a
        href={`mailto:${SITE.supportEmail}`}
        class="font-mono text-accent hover:underline"
      >{SITE.supportEmail}</a>
    </p>

    <p class="mt-6 text-sm text-text-body">{t('buySuccess.next')}</p>
    <div class="mt-4 flex flex-wrap gap-3">
      <a
        href={localizePath('/install', lang)}
        class="rounded-lg bg-accent px-5 py-3 font-medium text-void transition-transform hover:-translate-y-0.5 motion-reduce:hover:translate-y-0"
      >{t('buySuccess.installLink')}</a>
      <a
        href={localizePath('/', lang)}
        class="rounded-lg border border-border px-5 py-3 font-medium text-text-hi transition-colors hover:border-accent"
      >{t('buySuccess.home')}</a>
    </div>
  </section>
</BaseLayout>
