---
import '@/styles/global.css';

export function getStaticPaths() {
  return [{ params: { lang: 'en' } }, { params: { lang: 'ko' } }];
}

const { lang } = Astro.params;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <title>TeachFlow-KR</title>
  </head>
  <body>
    <h1 class="text-text-hi">TeachFlow-KR</h1>
  </body>
</html>
