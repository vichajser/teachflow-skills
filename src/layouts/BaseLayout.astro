---
import '@/styles/global.css';
import SeoHead from '@/components/SeoHead.astro';
import SiteHeader from '@/components/SiteHeader.astro';
import SiteFooter from '@/components/SiteFooter.astro';
import { useTranslations } from '@/i18n/t';
import type { Locale } from '@/i18n/config';

interface Props {
  lang: Locale;
  title: string;
  description: string;
  /**
   * **去掉语言前缀**的路径：`/pricing`、`/legal/refund`、`/` 表首页。
   * 不是 `Astro.url.pathname`（那个带前缀）。canonical 与 hreflang 由它派生。
   */
  path: string;
  /** 'legal' 关闭辉光与动效（spec §5.5 合规区静音） */
  variant?: 'marketing' | 'legal';
  /**
   * 是否声明 hreflang 语言备选，透传给 SeoHead。默认 true；错误页传 false
   * （404 不是语言的另一种呈现，两语 404 互为备选是 SEO 脏数据）。
   */
  alternates?: boolean;
}

const {
  lang,
  title,
  description,
  path,
  variant = 'marketing',
  alternates = true,
} = Astro.props;

const t = useTranslations(lang);
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <SeoHead
      lang={lang}
      title={title}
      description={description}
      path={path}
      alternates={alternates}
    />
    {/*
      Preload only the body weight of the reader's own language — five files
      preloaded would compete for first-paint bandwidth, and the 600 cut is not
      used above the fold. The files are absent until the site owner supplies
      them; a preload for a missing file is a no-op, not an error.
    */}
    {lang === 'en' && (
      <link
        rel="preload"
        href="/fonts/inter-latin-400.woff2"
        as="font"
        type="font/woff2"
        crossorigin
      />
    )}
    {lang === 'ko' && (
      <link
        rel="preload"
        href="/fonts/pretendard-korean-400.woff2"
        as="font"
        type="font/woff2"
        crossorigin
      />
    )}
  </head>
  <!--
    NO opaque background class here (no `bg-void`). The grid texture and the
    gradient border are pseudo-elements at `z-index: -1` in the *root* stacking
    context — nothing on this ancestor chain creates one — so by CSS 2.1 App. E
    they are painted in step 3, before the body background in step 4. An opaque
    body background therefore paints straight over them and both textures
    silently vanish. `html` already paints the same `--color-void`
    (global.css), so the visual baseline is identical without it. Guarded by
    tests/build/motion-budget.test.mjs.
  -->
  <body
    data-quiet={variant === 'legal' ? '' : undefined}
    class="min-h-screen text-text-body antialiased"
  >
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded focus:bg-raised focus:px-3 focus:py-2 focus:text-text-hi"
    >{t('a11y.skipToContent')}</a>

    <SiteHeader lang={lang} path={path} />
    <main id="main" class="mx-auto max-w-6xl px-4"><slot /></main>
    <SiteFooter lang={lang} path={path} />
  </body>
</html>
