---
import '@/styles/global.css';
import SeoHead from '@/components/SeoHead.astro';
import SiteHeader from '@/components/SiteHeader.astro';
import SiteFooter from '@/components/SiteFooter.astro';
import { useTranslations } from '@/i18n/t';
import type { Locale } from '@/i18n/config';

interface Props {
  lang: Locale;
  title: string;
  description: string;
  /**
   * **去掉语言前缀**的路径：`/buy`、`/legal/refund`、`/` 表首页。
   * 不是 `Astro.url.pathname`（那个带前缀）。canonical 与 hreflang 由它派生。
   */
  path: string;
  /** 'legal' 关闭辉光与动效（spec §5.5 合规区静音） */
  variant?: 'marketing' | 'legal';
  /**
   * 是否声明 hreflang 语言备选，透传给 SeoHead。默认 true；错误页传 false
   * （404 不是语言的另一种呈现，两语 404 互为备选是 SEO 脏数据）。
   */
  alternates?: boolean;
}

const {
  lang,
  title,
  description,
  path,
  variant = 'marketing',
  alternates = true,
} = Astro.props;

/*
 * Theme by locale (UX review 2026-09-21, C-1): Korean defaults to the light
 * theme — the dominant Korean consumer-SaaS aesthetic (토스/Kakao style white
 * with one brand blue) and the expectation of the teacher audience; English
 * keeps the original dark developer-tool identity. Token values flip under
 * html[data-theme] in global.css; no component changes and no JS. There is no
 * user-facing toggle in v1 — adding one means either a <script> exemption to
 * the zero-JS rule or per-theme static variants, both deferred by design.
 *
 * NOTE: this explanation lives in the frontmatter on purpose. An Astro
 * comment between <!doctype> and <html> is emitted as literal text and the
 * parser drops the <html> element itself (motion-budget tests caught it:
 * "has no <body>"). Same class of pitfall as the <body> comment below.
 */

const t = useTranslations(lang);
---

<!doctype html>
<html lang={lang} data-theme={lang === 'ko' ? 'light' : 'dark'}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <SeoHead
      lang={lang}
      title={title}
      description={description}
      path={path}
      alternates={alternates}
    />
    {/*
      Preload only the body weight of the reader's own language — five files
      preloaded would compete for first-paint bandwidth, and the 600 cut is not
      used above the fold. The files are absent until the site owner supplies
      them; a preload for a missing file is a no-op, not an error.
    */}
    {lang === 'en' && (
      <link
        rel="preload"
        href="/fonts/inter-latin-400.woff2"
        as="font"
        type="font/woff2"
        crossorigin
      />
    )}
    {lang === 'ko' && (
      <link
        rel="preload"
        href="/fonts/pretendard-korean-400.woff2"
        as="font"
        type="font/woff2"
        crossorigin
      />
    )}
  </head>
  <body
    data-quiet={variant === 'legal' ? '' : undefined}
    class="min-h-screen text-text-body antialiased"
  >
    {/*
      About the `class` on the `<body>` tag directly above — the comment sits
      *inside* `<body>` rather than above it because Astro only evaluates
      `{/* … *\/}` where an expression is legal, and the slot between `</head>`
      and `<body>` is not: a comment placed there is emitted into the document
      as literal text. Verified against dist/.

      NO opaque background class here (no `bg-void`). The grid texture and the
      gradient border are pseudo-elements at `z-index: -1` in the *root* stacking
      context — nothing on this ancestor chain creates one — so by CSS 2.1 App. E
      they are painted in step 3, before the body background in step 4. An opaque
      body background therefore paints straight over them and both textures
      silently vanish. `html` already paints the same `--color-void`
      (global.css), so the visual baseline is identical without it. Guarded by
      tests/build/motion-budget.test.mjs.
    */}
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-[60] focus:rounded focus:bg-raised focus:px-3 focus:py-2 focus:text-text-hi"
    >{t('a11y.skipToContent')}</a>

    <SiteHeader lang={lang} path={path} />
    <main id="main" class="mx-auto max-w-6xl px-4"><slot /></main>
    {/*
      Back-to-top (UX review 2026-09-21, C-4): long pages (/skills, /install)
      previously offered no way back except manual scroll. A plain anchor to
      #main keeps the zero-JS rule; the existing skip link targets the same
      anchor from the other direction.
    */}
    <p class="mx-auto max-w-6xl px-4 pb-2 text-right">
      <a
        href="#main"
        class="text-sm text-text-mute transition-colors hover:text-text-hi"
      >↑ {t('a11y.backToTop')}</a>
    </p>
    <SiteFooter lang={lang} path={path} />
  </body>
</html>
